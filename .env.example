# ── Master (Mac) ─────────────────────────────────────────────
# Copy this file to .env on the Mac before running the master.
# No changes are required — defaults work out of the box.

# Load balancing strategy: least_tasks | lowest_resource | fastest_response | gpu_aware
LB_STRATEGY=gpu_aware

# Model that workers must have pulled via: ollama pull llama3.1:8b
LLM_MODEL=llama3.1:8b

# Grafana dashboard login at http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
