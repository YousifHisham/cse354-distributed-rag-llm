# ── Master ────────────────────────────────────────────────────
# Copy this file to .env and fill in the Thunder Compute URLs.

# Load balancing strategy: least_tasks | lowest_resource | fastest_response | gpu_aware
LB_STRATEGY=gpu_aware

# Model that must be running on every Thunder Compute Ollama instance
LLM_MODEL=llama3.1:8b

# Grafana dashboard login at http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Thunder Compute Ollama endpoints ──────────────────────────
# Forward port 11434 on each instance to get these URLs.
THUNDER_COMPUTE_URL_1=https://INSTANCE_1-11434.thundercompute.net
THUNDER_COMPUTE_URL_2=https://INSTANCE_2-11434.thundercompute.net
THUNDER_COMPUTE_URL_3=https://INSTANCE_3-11434.thundercompute.net
THUNDER_COMPUTE_URL_4=https://INSTANCE_4-11434.thundercompute.net
THUNDER_COMPUTE_URL_5=https://INSTANCE_5-11434.thundercompute.net

# ── Thunder Compute GPU metrics endpoints (optional) ──────────
# Run thunder_metrics.py on each instance and forward port 8888.
# If not set, workers fall back to Ollama /api/ps for VRAM only.
THUNDER_METRICS_URL_1=https://INSTANCE_1-8888.thundercompute.net
THUNDER_METRICS_URL_2=https://INSTANCE_2-8888.thundercompute.net
THUNDER_METRICS_URL_3=https://INSTANCE_3-8888.thundercompute.net
THUNDER_METRICS_URL_4=https://INSTANCE_4-8888.thundercompute.net
THUNDER_METRICS_URL_5=https://INSTANCE_5-8888.thundercompute.net

# ── Client ────────────────────────────────────────────────────
NUM_REQUESTS=20

# ── Thunder Compute Ollama endpoints ──────────────────────────
# Get these from your Thunder Compute dashboard.
# Each URL is the public Ollama endpoint for one GPU instance.
THUNDER_COMPUTE_URL_1=https://INSTANCE_1.thundercompute.net
THUNDER_COMPUTE_URL_2=https://INSTANCE_2.thundercompute.net
THUNDER_COMPUTE_URL_3=https://INSTANCE_3.thundercompute.net
THUNDER_COMPUTE_URL_4=https://INSTANCE_4.thundercompute.net
THUNDER_COMPUTE_URL_5=https://INSTANCE_5.thundercompute.net

# ── Client ────────────────────────────────────────────────────
NUM_REQUESTS=20
