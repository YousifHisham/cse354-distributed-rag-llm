# ============================================================
# Distributed RAG-Augmented LLM System — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ─── Master / Control Plane ──────────────────────────────────
# Uvicorn coordinator port inside the control container.
COORDINATOR_PORT=8000

# Load balancing strategy for routing requests to workers.
# Valid values: least_tasks | lowest_resource | fastest_response | gpu_aware
LB_STRATEGY=gpu_aware

# Maximum queued requests before the coordinator returns HTTP 429.
MAX_QUEUE_SIZE=5000

# Maximum number of retry attempts after the first failed worker call.
MAX_RETRIES=2

# Timeout in seconds for coordinator → worker HTTP calls.
REQUEST_TIMEOUT_SECONDS=60

# Seconds after which a worker with no heartbeat is marked unavailable.
WORKER_STALENESS_SECONDS=3

# Ollama model requested from workers. Must be pulled on every GPU node.
# If this tag is unavailable, check with: ollama list / ollama pull llama3.2:8b
LLM_MODEL=llama3.2:8b

# ─── Master / RAG + Chroma ────────────────────────────────────
# Number of RAG context passages to retrieve per query.
RAG_TOP_K=3

# Path inside the control container where knowledge base documents are stored.
KNOWLEDGE_DIR=/app/knowledge

# Sentence-transformer model name for computing RAG embeddings.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chroma vector database connection. In Docker Compose, use service name "chroma".
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=project_knowledge

# ─── Master / NGINX Gateway ───────────────────────────────────
# NGINX proxy read timeout. Must be greater than REQUEST_TIMEOUT_SECONDS.
NGINX_PROXY_READ_TIMEOUT=90

# NGINX worker_connections value for high concurrency.
NGINX_WORKER_CONNECTIONS=4096

# ─── Worker Node ──────────────────────────────────────────────
# Human-friendly name only. The coordinator assigns the real worker_id.
WORKER_NAME=gpu-worker

# Port this worker's FastAPI app listens on.
WORKER_PORT=8001

# Host/IP the coordinator can use to call this worker.
# On a cloud GPU node, set this to the node's public/private reachable IP.
WORKER_HOST=127.0.0.1

# Public coordinator URL reachable from the worker. For ngrok, use its HTTPS URL.
COORDINATOR_URL=http://host.docker.internal:80

# Ollama URL on the GPU host. With host networking, localhost is correct.
OLLAMA_BASE_URL=http://localhost:11434

# Lightweight liveness heartbeat interval.
HEARTBEAT_INTERVAL_SECONDS=0.5

# Full load-balancing metrics interval.
METRICS_INTERVAL_SECONDS=1

# Coordinator registration retry interval on worker startup.
REGISTRATION_RETRY_SECONDS=2

# Number of recent completed requests used for rolling average latency.
LATENCY_WINDOW=20

# ─── Monitoring ───────────────────────────────────────────────
# Admin credentials for Grafana UI at http://localhost:3000.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
