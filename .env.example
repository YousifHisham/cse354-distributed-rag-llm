# Copy to .env and fill in the Thunder Compute URLs.
# Runtime defaults such as internal ports and NGINX timeouts are set by the containers.

# Load balancing strategy: least_tasks | lowest_resource | fastest_response | gpu_aware
LB_STRATEGY=gpu_aware

# Model that must be pulled and served by every Thunder Compute Ollama instance.
LLM_MODEL=llama3.1:8b

# Maximum generated answer length. Keeps load tests stable and prevents very long responses.
OLLAMA_MAX_OUTPUT_TOKENS=300

# Keep each model loaded on Thunder between requests to avoid cold-start latency.
OLLAMA_KEEP_ALIVE=30m

# Coordinator, worker inference, and load-test clients wait indefinitely for responses.
# NGINX still requires a finite proxy timeout, so keep it very large.
NGINX_PROXY_READ_TIMEOUT=86400
HEARTBEAT_INTERVAL_SECONDS=0.5
WORKER_MISSED_HEARTBEATS=6

# Keep each worker from flooding one Ollama process with hundreds of simultaneous generations.
OLLAMA_MAX_CONCURRENT_REQUESTS=4

# Grafana dashboard login at http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Thunder Compute public Ollama endpoints for port 11434.
THUNDER_COMPUTE_URL_1=https://INSTANCE_1-11434.thundercompute.net
THUNDER_COMPUTE_URL_2=https://INSTANCE_2-11434.thundercompute.net
THUNDER_COMPUTE_URL_3=https://INSTANCE_3-11434.thundercompute.net
THUNDER_COMPUTE_URL_4=https://INSTANCE_4-11434.thundercompute.net
THUNDER_COMPUTE_URL_5=https://INSTANCE_5-11434.thundercompute.net

THUNDER_METRICS_URL_1=https://INSTANCE_1-8888.thundercompute.net
THUNDER_METRICS_URL_2=https://INSTANCE_2-8888.thundercompute.net
THUNDER_METRICS_URL_3=https://INSTANCE_3-8888.thundercompute.net
THUNDER_METRICS_URL_4=https://INSTANCE_4-8888.thundercompute.net
THUNDER_METRICS_URL_5=https://INSTANCE_5-8888.thundercompute.net
